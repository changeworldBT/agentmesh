#!/bin/bash
# am —— AgentMesh 任务速用命令（VPS 宿主直接跑）
# 用法:
#   am "<目标描述>"            提交任务，打印 task_id
#   am status <task_id>        查任务状态（status/子任务）
#   am events <task_id>        看任务事件轨迹（最近 15 条）
#   am token                   打印 API 令牌（面板登录用，一次输入存浏览器）
#   am ls                      最近 10 个任务
# 依赖: docker 容器 agentmesh-core 在跑；sudo -n docker 可用。
set -euo pipefail
C=agentmesh-core
PY() { sudo -n docker exec -w /opt/agentmesh "$C" python -c "$1"; }

case "${1:-}" in
  token)
    PY "from app.engine.credentials import CredentialManager
from app.engine.db import Database
db = Database('/opt/agentmesh/data/agentmesh.db')
cm = CredentialManager(database=db, encrypted_path='/opt/agentmesh/credentials/credentials.enc', age_key_path='/run/secrets/age_key')
print(cm.api_token() or '')"
    ;;
  ls)
    PY "import json, urllib.request
from app.engine.credentials import CredentialManager
from app.engine.db import Database
db = Database('/opt/agentmesh/data/agentmesh.db')
cm = CredentialManager(database=db, encrypted_path='/opt/agentmesh/credentials/credentials.enc', age_key_path='/run/secrets/age_key')
tok = cm.api_token()
req = urllib.request.Request('http://127.0.0.1:8787/api/v1/tasks?limit=10', headers={'Authorization':'Bearer '+tok})
for t in json.loads(urllib.request.urlopen(req).read().decode()) if isinstance(json.loads(urllib.request.urlopen(req).read().decode()), list) else []:
    print(t['task_id'], t['status'], t['title'][:40])" 2>/dev/null || PY "import json, urllib.request
from app.engine.credentials import CredentialManager
from app.engine.db import Database
db = Database('/opt/agentmesh/data/agentmesh.db')
cm = CredentialManager(database=db, encrypted_path='/opt/agentmesh/credentials/credentials.enc', age_key_path='/run/secrets/age_key')
tok = cm.api_token()
req = urllib.request.Request('http://127.0.0.1:8787/api/v1/tasks', headers={'Authorization':'Bearer '+tok})
d = json.loads(urllib.request.urlopen(req).read().decode())
items = d if isinstance(d, list) else d.get('items', d.get('tasks', []))
for t in items[:10]:
    print(t.get('task_id'), t.get('status'), str(t.get('title'))[:40])"
    ;;
  status)
    [ -n "${2:-}" ] || { echo "用法: am status <task_id>"; exit 1; }
    PY "import json, urllib.request, urllib.error
from app.engine.credentials import CredentialManager
from app.engine.db import Database
db = Database('/opt/agentmesh/data/agentmesh.db')
cm = CredentialManager(database=db, encrypted_path='/opt/agentmesh/credentials/credentials.enc', age_key_path='/run/secrets/age_key')
tok = cm.api_token()
req = urllib.request.Request('http://127.0.0.1:8787/api/v1/tasks/$2', headers={'Authorization':'Bearer '+tok})
try:
    t = json.loads(urllib.request.urlopen(req).read().decode())
except urllib.error.HTTPError as e:
    print('查询失败:', e.code, '——检查 task_id 是否正确'); raise SystemExit(0)
print('status:', t.get('status'), ' error:', t.get('error'))
for s in t.get('subtasks', []) or []:
    print(' sub:', s.get('status'), str(s.get('title') or s.get('objective'))[:50])"
    ;;
  events)
    [ -n "${2:-}" ] || { echo "用法: am events <task_id>"; exit 1; }
    PY "import json, urllib.request
from app.engine.credentials import CredentialManager
from app.engine.db import Database
db = Database('/opt/agentmesh/data/agentmesh.db')
cm = CredentialManager(database=db, encrypted_path='/opt/agentmesh/credentials/credentials.enc', age_key_path='/run/secrets/age_key')
tok = cm.api_token()
req = urllib.request.Request('http://127.0.0.1:8787/api/v1/events?task_id=$2', headers={'Authorization':'Bearer '+tok})
ev = json.loads(urllib.request.urlopen(req).read().decode())
items = ev if isinstance(ev, list) else ev.get('events', ev.get('items', []))
for e in items[-15:]:
    print(e.get('event_type'), str(e.get('payload'))[:140])"
    ;;
  "")
    echo "用法: am \"<目标>\" | am status <id> | am events <id> | am ls | am token"; exit 1 ;;
  *)
    GOAL="$1"
    PY "import json, urllib.request
from app.engine.credentials import CredentialManager
from app.engine.db import Database
db = Database('/opt/agentmesh/data/agentmesh.db')
cm = CredentialManager(database=db, encrypted_path='/opt/agentmesh/credentials/credentials.enc', age_key_path='/run/secrets/age_key')
tok = cm.api_token()
body = json.dumps({'title': '''$(printf '%s' "$GOAL" | cut -c1-60)''', 'goal': '''$GOAL'''}).encode()
req = urllib.request.Request('http://127.0.0.1:8787/api/v1/tasks', data=body, headers={'Authorization':'Bearer '+tok, 'Content-Type':'application/json'})
r = json.loads(urllib.request.urlopen(req).read().decode())
print(r['task_id'])"
    echo "提交成功。查看: ssh instabox am status <id>；产物在 /data/agentmesh/workspaces/<id>/"
    ;;
esac
